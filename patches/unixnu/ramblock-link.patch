+
+// The BBK A2 kernel links RamBlock without a persistent-store provider and
+// without the loader-memory release patch.  The weak_import declarations do
+// not survive XNU's static link (ld reports them as undefined), so provide
+// the volatile-disk behaviour directly: mode 0 makes attachStore() keep the
+// RAM-only disk, and a false release keeps the seed pages mapped.
+extern "C" {
+bool ml_static_mfree_prepare(vm_offset_t, vm_size_t) { return false; }
+unsigned native_ufs_store_mode(void) { return 0; }
+int native_ufs_store_open(uint64_t, uint64_t *, const char **) { return 0; }
+int native_ufs_store_read(uint64_t, uint32_t, void *) { return 0; }
+int native_ufs_store_write(uint64_t, uint32_t, const void *) { return 0; }
+int native_ufs_store_write_cached(uint64_t, uint32_t, const void *) { return 0; }
+int native_ufs_store_sync(void) { return 0; }
+unsigned native_ufs_store_gpt_check(void) { return 0; }
+}
