@@ -36,6 +36,23 @@ static inline int native_legacy_surface_bounds(uint32_t width,uint32_t height,
     return allocation>=stride*height && descriptorBytes>=allocation;
 }
 
+// Cache maintenance reaches the last visible pixel. The mapping may also
+// contain aligned rows or data that the CPU presenter never reads.
+static inline uint32_t native_legacy_cpu_read_span(uintptr_t address,
+    uint64_t mappingBytes, uint64_t stride, uint32_t width, uint32_t height,
+    uint32_t bytesPerPixel) {
+    if (!address || !width || !height || width>16384 || height>16384 ||
+        (bytesPerPixel!=4 && bytesPerPixel!=8)) return 0;
+
+    const uint32_t rowBytes=width*bytesPerPixel;
+    if (stride<rowBytes ||
+        (height>1 && stride>(UINT32_MAX-rowBytes)/(height-1))) return 0;
+
+    const uint64_t span=stride*(height-1)+rowBytes;
+    if (span>mappingBytes || address>UINTPTR_MAX-span) return 0;
+    return (uint32_t)span;
+}
+
 // The GOP destination is device memory: use aligned scalar pixel stores,
 // never a general memcpy that may issue unaligned or wider device accesses.
 // The source is normal mapped IOSurface memory and may have padded rows.
