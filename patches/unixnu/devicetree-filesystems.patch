+FILESYSTEM_FLAGS = {'e-apfs', 'e-apfs-1', 'vol.fs_ephemeral'}
+
+
+def filesystems_node(entry):
+    """Serialize the root-level /filesystems subtree exactly as Apple expects.
+
+    Unlike hardware nodes this keeps every property: flags (zero length), ADT
+    strings and little-endian U32 cells.  mount reads the fstab entries through
+    IODeviceTree:/filesystems/fstab and matches the vol.fs_* field names.
+    """
+    properties = []
+    for name, value in entry.properties.items():
+        if len(name) > 31:
+            raise Error(f'ADT property name exceeds 31 bytes: {name}')
+        if name in FILESYSTEM_FLAGS or value == b'':
+            properties.append((name, b''))
+        elif len(value) % 4 == 0 and len(value) <= 16:
+            cells = b''.join(struct.pack('<I', struct.unpack('>I', value[offset:offset + 4])[0])
+                             for offset in range(0, len(value), 4))
+            properties.append((name, cells))
+        else:
+            properties.append((name, value if value.endswith(b'\0') else value + b'\0'))
+    return node(entry.name, properties, [filesystems_node(child) for child in entry.children])
+
