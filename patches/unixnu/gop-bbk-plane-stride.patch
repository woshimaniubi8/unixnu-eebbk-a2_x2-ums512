+// Apple?s &BGA surface exposes a root stride that is not the backing-plane
+// byte stride. Use the qualified original plane getter for this format only.
+static inline bool nativeBgraLayout(OSObject *surface,uint32_t format,uint32_t planes,
+    uint64_t *stride,uint64_t *allocation) {
+    if(!surface || !stride || !allocation)return false;
+    *stride=native_legacy_surface_stride(surface);
+    *allocation=native_legacy_surface_allocation(surface);
+    if(format==0x26424741 && planes==1) {
+        const uint64_t width=native_legacy_plane_width(surface,0);
+        const uint64_t height=native_legacy_plane_height(surface,0);
+        const uint64_t planeStride=native_legacy_plane_stride(surface,0);
+        const uint64_t planeAllocation=native_legacy_plane_allocation(surface,0);
+        if(!width || !height || !planeStride || !planeAllocation)return false;
+        *stride=planeStride;*allocation=planeAllocation;
+    }
+    return true;
+}
