+	/* The original daemon preserves its restart reason/context in x20/x19.
+	 * Observe a small number of real exit calls independently of the path budget.
+	 * Bounded copyin never dereferences user pointers directly. */
+	static uint32_t bbk_bt_exit_reasons;
+	if (code == 1 && strcmp(proc_best_name(proc), "bluetoothd") == 0 &&
+	    __atomic_fetch_add(&bbk_bt_exit_reasons, 1u, __ATOMIC_RELAXED) < 8) {
+		uint64_t context = get_saved_state_reg(state, 19);
+		uint64_t reason = get_saved_state_reg(state, 20);
+		uint64_t fp = get_saved_state_fp(state);
+		uint64_t sp = get_saved_state_sp(state);
+		char message[160] = {0};
+		size_t length = 0;
+		int copy_error = copyinstr((user_addr_t)context, message, sizeof(message), &length);
+		if (copy_error != 0) {
+			message[0] = 0;
+		}
+		for (unsigned int i = 0; i < sizeof(message) - 1 && message[i] != 0; ++i) {
+			if ((unsigned char)message[i] < 32 || (unsigned char)message[i] > 126) {
+				message[i] = '?';
+			}
+		}
+		message[sizeof(message) - 1] = 0;
+		printf("M143 bt reason: pid=%d tid=%llu x19=0x%llx x20=0x%llx copy=%d context=%s fp=0x%llx sp=0x%llx lr=0x%llx\n",
+		    proc_getpid(proc), (unsigned long long)thread_tid(current_thread()),
+		    (unsigned long long)context, (unsigned long long)reason, copy_error, message,
+		    (unsigned long long)fp, (unsigned long long)sp,
+		    (unsigned long long)get_saved_state_lr(state));
+		for (unsigned int frame = 0; frame < 6; ++frame) {
+			uint64_t words[2] = {0};
+			if ((fp >> 48) != 0 || (fp & 15) != 0 || fp < sp || fp - sp > 0x10000 - sizeof(words)) {
+				break;
+			}
+			int error = copyin((user_addr_t)fp, words, sizeof(words));
+			printf("M143 bt frame: pid=%d index=%u fp=0x%llx copy=%d next=0x%llx ret=0x%llx\n",
+			    proc_getpid(proc), frame, (unsigned long long)fp, error,
+			    (unsigned long long)words[0], (unsigned long long)words[1]);
+			if (error != 0 || words[0] <= fp) {
+				break;
+			}
+			fp = words[0];
+		}
+	}
+	static uint32_t bbk_bt_syscalls;
+	bool bbk_bt_observe = false;
+	const char *bbk_trace_name = proc_best_name(proc);
+	if (strcmp(bbk_trace_name, "bluetoothd") == 0 || strcmp(bbk_trace_name, "SpringBoard") == 0) {
+		switch (code) {
+		case 1: case 5: case 33: case 37: case 54: case 97: case 98:
+		case 202: case 274: case 328: case 338: case 340: case 463: case 464: case 466: case 521:
+			bbk_bt_observe = __atomic_fetch_add(&bbk_bt_syscalls, 1u, __ATOMIC_RELAXED) < 1024;
+			break;
+		default: break;
+		}
+	}
+	if (bbk_bt_observe) {
+		if (code == 5 || code == 33 || code == 338 || code == 340 || code == 463 || code == 464 || code == 466) {
+			char path[192] = {0};
+			size_t path_length = 0;
+			unsigned int path_index = (code == 463 || code == 464 || code == 466) ? 1 : 0;
+			int path_error = copyinstr((user_addr_t)uthread->uu_arg[path_index], path, sizeof(path), &path_length);
+			path[sizeof(path) - 1] = '\0';
+			printf("M142 bt path: pid=%d tid=%llu code=%u copy=%d len=%lu path=%s lr=0x%llx\n",
+			    proc_getpid(proc), (unsigned long long)thread_tid(current_thread()),
+			    code, path_error, (unsigned long)path_length, path,
+			    (unsigned long long)get_saved_state_lr(state));
+		}
+		printf("M140 bt syscall: enter pid=%d tid=%llu code=%u a0=0x%llx a1=0x%llx pc=0x%llx lr=0x%llx\n",
+		    proc_getpid(proc), (unsigned long long)thread_tid(current_thread()), code,
+		    (unsigned long long)uthread->uu_arg[0], (unsigned long long)uthread->uu_arg[1],
+		    (unsigned long long)get_saved_state_pc(state), (unsigned long long)get_saved_state_lr(state));
+	}
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
+	if (bbk_bt_observe) {
+		printf("M140 bt syscall: return pid=%d tid=%llu code=%u error=%d ret=0x%llx\n",
+		    proc_getpid(proc), (unsigned long long)thread_tid(current_thread()), code, error,
+		    (unsigned long long)*((uint64_t *)(&uthread->uu_rval[0])));
+	}
+
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 
