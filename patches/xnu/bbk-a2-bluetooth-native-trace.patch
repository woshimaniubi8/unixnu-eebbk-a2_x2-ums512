+/* Bounded observation of the original daemon's own stderr/stdout.
+ * Keep file I/O and all native startup failures unchanged. */
+static void
+bbk_bluetooth_write_trace(struct proc *p, int fd, user_addr_t address, user_size_t size)
+{
+	static uint32_t messages;
+	if ((fd != 1 && fd != 2) || size == 0 || strcmp(proc_best_name(p), "bluetoothd") != 0) {
+		return;
+	}
+	if (__atomic_fetch_add(&messages, 1u, __ATOMIC_RELAXED) >= 256) {
+		return;
+	}
+	char text[256] = {0};
+	unsigned int bytes = size < sizeof(text) ? (unsigned int)size : (unsigned int)sizeof(text) - 1;
+	int error = copyin(address, text, bytes);
+	if (error == 0) {
+		for (unsigned int i = 0; i < bytes; ++i) {
+			if ((unsigned char)text[i] < 32 || (unsigned char)text[i] == 127) {
+				text[i] = ' ';
+			}
+		}
+	} else {
+		text[0] = 0;
+	}
+	/* Preserve device identity in the private raw source, not console copies. */
+	if (strnstr(text, "Got local-mac-address:", sizeof(text)) != NULL) {
+		strlcpy(text, "bluetooth: Got local-mac-address: [private-address]", sizeof(text));
+	}
+	printf("M139 bt native: pid=%d fd=%d bytes=%u copy=%d text=%s\n",
+	    proc_getpid(p), fd, bytes, error, text);
+}
+
 int
 write_nocancel(struct proc *p, struct write_nocancel_args *uap, user_ssize_t *retval)
 {
+	bbk_bluetooth_write_trace(p, uap->fd, uap->cbuf, uap->nbyte);
 	return write_internal(p, uap->fd, uap->cbuf, uap->nbyte, (off_t)-1, 0,
 	           NULL, retval);
 }
