diff --git a/bsd/kern/sys_generic.c b/bsd/kern/sys_generic.c
index e8011a0..dfed08c 100644
--- a/bsd/kern/sys_generic.c
+++ b/bsd/kern/sys_generic.c
@@ -729,12 +729,54 @@ bbk_bluetooth_write_trace(struct proc *p, int fd, user_addr_t address, user_size
 	    "M139 bt native: pid=%d fd=%d bytes=%u copy=%d text=%s\n",
 	    proc_getpid(p), fd, bytes, error, text);
 }
 
+static int
+bbk_ui_contains(const char *haystack, const char *needle)
+{
+	size_t length = strlen(needle);
+	if (length == 0) {
+		return 1;
+	}
+	for (const char *at = haystack; *at != '\0'; ++at) {
+		if (strncmp(at, needle, length) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static void
+bbk_ui_write_trace(struct proc *p, int fd, user_addr_t buf, size_t len)
+{
+	static uint32_t writes;
+	if (len == 0 || len > 512) {
+		return;
+	}
+	char text[513] = {0};
+	if (copyin(buf, text, len) != 0) {
+		return;
+	}
+	text[len] = '\0';
+	const char *name = proc_best_name(p);
+	int named = name != NULL && (strcmp(name, "SpringBoard") == 0 ||
+	    strcmp(name, "backboardd") == 0 || strcmp(name, "mali-user-probe") == 0);
+	if (!named && !bbk_ui_contains(text, "SpringBoard") &&
+	    !bbk_ui_contains(text, "BackBoard") && !bbk_ui_contains(text, "FBSScene")) {
+		return;
+	}
+	if (__atomic_fetch_add(&writes, 1u, __ATOMIC_RELAXED) >= 4096) {
+		return;
+	}
+	printf("M270 ui write: pid=%d name=%s fd=%d len=%llu text=%s\n",
+	    proc_getpid(p), name ? name : "?", fd, (unsigned long long)len, text);
+}
+
 int
 write_nocancel(struct proc *p, struct write_nocancel_args *uap, user_ssize_t *retval)
 {
 	bbk_bluetooth_write_trace(p, uap->fd, uap->cbuf, uap->nbyte);
+	bbk_ui_write_trace(p, uap->fd, uap->cbuf, uap->nbyte);
 	return write_internal(p, uap->fd, uap->cbuf, uap->nbyte, (off_t)-1, 0,
 	           NULL, retval);
 }
 
