+extern int native_bbk_ui_is_springboard_main(int pid, uint64_t tid);
+
+int
+mprotect(proc_t p, struct mprotect_args *uap, int32_t *retval)
+{
+	uint64_t tid = thread_tid(current_thread());
+	int pid = proc_getpid(p);
+	int trace = native_bbk_ui_is_springboard_main(pid, tid);
+	uint64_t entered = 0;
+	if (trace) {
+		entered = mach_absolute_time();
+		printf("M94 mprotect: enter pid=%d tid=%llu map=%p addr=0x%llx len=0x%llx prot=0x%x t=%llu\n",
+		    pid, (unsigned long long)tid, current_map(),
+		    (unsigned long long)uap->addr, (unsigned long long)uap->len,
+		    uap->prot, (unsigned long long)entered);
+	}
+	/* Preserve every original validation, MAC check, VM operation and errno. */
+	int error = native_bbk_mprotect_impl(p, uap, retval);
+	if (trace) {
+		uint64_t elapsed;
+		absolutetime_to_nanoseconds(mach_absolute_time() - entered, &elapsed);
+		printf("M94 mprotect: return pid=%d tid=%llu addr=0x%llx len=0x%llx prot=0x%x err=%d ns=%llu t=%llu\n",
+		    pid, (unsigned long long)tid, (unsigned long long)uap->addr,
+		    (unsigned long long)uap->len, uap->prot, error,
+		    (unsigned long long)elapsed, (unsigned long long)entered);
+	}
+	return error;
 }
 
 
