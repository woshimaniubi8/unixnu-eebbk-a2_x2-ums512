+int
+native_bbk_ui_is_springboard_main(int pid, uint64_t tid)
+{
+	return os_atomic_load(&bbk_ui_enabled, acquire) && pid > 0 &&
+	       pid == os_atomic_load(&bbk_ui_pids[0], acquire) &&
+	       tid == os_atomic_load(&bbk_ui_main_tids[0], acquire);
 }
 
