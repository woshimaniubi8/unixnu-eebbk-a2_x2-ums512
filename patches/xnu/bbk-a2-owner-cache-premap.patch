+
+/*
+ * BBK A2 bring-up: preload the owner's main dyld shared cache into the task's
+ * shared region before launchd execs, like iBoot does on real hardware.  The
+ * OS image has no loose dylibs, so dyld only proceeds when
+ * shared_region_check_np() reports an already-mapped region.  Only the main
+ * cache file is mapped here (from its own header mapping table, slide 0); dyld
+ * maps the subcaches afterwards through shared_region_map_and_slide_2_np(),
+ * where the owner cache carrier accepts them.  Fails soft.
+ */
+struct bbk_dyld_cache_header_prefix {
+	char     magic[16];
+	uint32_t mappingOffset;
+	uint32_t mappingCount;
+};
+
+struct bbk_dyld_cache_mapping_info {
+	uint64_t address;
+	uint64_t size;
+	uint64_t fileOffset;
+	uint32_t maxProt;
+	uint32_t initProt;
+};
+
+#define BBK_DYLD_CACHE_MAGIC "dyld_v1   arm64"
+#define BBK_DYLD_MAX_MAPPINGS 16
+
+/* Set by load_init_program before it execs launchd; consumed by vm_map_exec
+ * once the exec has entered the shared region for the new map. */
+int native_owner_cache_premap_pending = 0;
+
+int
+native_owner_cache_premap(task_t task)
+{
+	native_owner_cache_premap_pending = 0;
+	const char *path =
+	    "/private/preboot/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64";
+	struct bbk_dyld_cache_header_prefix header;
+	struct bbk_dyld_cache_mapping_info infos[BBK_DYLD_MAX_MAPPINGS];
+	struct _sr_file_mappings *srfmp = NULL;
+	struct shared_file_mapping_slide_np *mappings = NULL;
+	vnode_t vp = NULLVP;
+	vm_shared_region_t shared_region = NULL;
+	off_t size = 0;
+	int error = 0;
+	int aresid = 0;
+	kern_return_t kr = KERN_SUCCESS;
+
+	shared_region = vm_shared_region_get(task);
+	if (shared_region == NULL) {
+		printf("bbk sr: premap no shared region after exec enter\n");
+		return EIO;
+	}
+	{
+		mach_vm_offset_t start = 0;
+		if (vm_shared_region_start_address(shared_region, &start, task) == KERN_SUCCESS) {
+			printf("bbk sr: premap already mapped start=0x%llx\n",
+			    (unsigned long long)start);
+			return 0;
+		}
+	}
+
+	error = vnode_lookup(path, 0, &vp, vfs_context_current());
+	if (error) {
+		printf("bbk sr: premap lookup err=%d\n", error);
+		return error;
+	}
+	bzero(&header, sizeof(header));
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)&header, sizeof(header), 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(vfs_context_current()), &aresid, current_proc());
+	if (error || memcmp(header.magic, BBK_DYLD_CACHE_MAGIC, sizeof(header.magic)) != 0 ||
+	    header.mappingCount == 0 || header.mappingCount > BBK_DYLD_MAX_MAPPINGS) {
+		printf("bbk sr: premap header err=%d magic=%.16s count=%u\n", error, header.magic,
+		    header.mappingCount);
+		vnode_put(vp);
+		return EINVAL;
+	}
+	bzero(infos, sizeof(infos));
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)infos, header.mappingCount * sizeof(infos[0]),
+	    (off_t)header.mappingOffset, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(vfs_context_current()), &aresid, current_proc());
+	if (error) {
+		printf("bbk sr: premap mappings err=%d\n", error);
+		vnode_put(vp);
+		return error;
+	}
+	mappings = (struct shared_file_mapping_slide_np *)kalloc_data(
+	    header.mappingCount * sizeof(*mappings), Z_WAITOK | Z_ZERO);
+	srfmp = (struct _sr_file_mappings *)kalloc_data(sizeof(*srfmp), Z_WAITOK | Z_ZERO);
+	if (mappings == NULL || srfmp == NULL) {
+		printf("bbk sr: premap allocation failed\n");
+		error = ENOMEM;
+		goto out;
+	}
+	error = vnode_size(vp, &size, vfs_context_current());
+	if (error) {
+		printf("bbk sr: premap vnode_size err=%d\n", error);
+		goto out;
+	}
+	/*
+	 * vm_shared_region_map_file_setup() serves fd == -1 mappings by
+	 * copyin()ing sms_size bytes of page data from the user address stored
+	 * in sms_file_offset (the anonymous-object path), so stage the main
+	 * cache stub in a user buffer of the exec'ing task and point the mapping
+	 * at it.  The subcaches stay file-backed and are mapped by dyld itself
+	 * through shared_region_map_and_slide_2_np().
+	 */
+	mach_vm_offset_t data_addr = 0;
+	mach_vm_size_t data_size = round_page((mach_vm_size_t)size);
+	caddr_t data_buffer = NULL;
+	error = mach_vm_allocate_kernel(current_map(), &data_addr, data_size,
+	    VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
+	if (error) {
+		printf("bbk sr: premap user buffer err=%d\n", error);
+		goto out;
+	}
+	data_buffer = kalloc_data(data_size, Z_WAITOK);
+	if (data_buffer == NULL) {
+		printf("bbk sr: premap data buffer allocation failed\n");
+		error = ENOMEM;
+		goto out;
+	}
+	bzero(data_buffer, data_size);
+	error = vn_rdwr(UIO_READ, vp, data_buffer, (int)size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(vfs_context_current()), &aresid, current_proc());
+	if (error) {
+		printf("bbk sr: premap cache read err=%d\n", error);
+		goto out;
+	}
+	error = copyout(data_buffer, (user_addr_t)data_addr, (size_t)size);
+	if (error) {
+		printf("bbk sr: premap copyout err=%d\n", error);
+		goto out;
+	}
+	for (uint32_t index = 0; index < header.mappingCount; ++index) {
+		mappings[index].sms_address = (mach_vm_address_t)infos[index].address;
+		mappings[index].sms_size = (mach_vm_size_t)infos[index].size;
+		mappings[index].sms_file_offset = (mach_vm_offset_t)data_addr;
+		mappings[index].sms_max_prot = (vm_prot_t)infos[index].maxProt;
+		mappings[index].sms_init_prot = (vm_prot_t)infos[index].initProt;
+		printf("bbk sr: premap map[%u] addr=0x%llx size=0x%llx data=0x%llx prot=0x%x/0x%x\n",
+		    index, (unsigned long long)infos[index].address,
+		    (unsigned long long)infos[index].size,
+		    (unsigned long long)data_addr, infos[index].maxProt,
+		    infos[index].initProt);
+	}
+	srfmp->fd = -1;
+	srfmp->mappings_count = header.mappingCount;
+	srfmp->mappings = mappings;
+	srfmp->slide = 0;
+	srfmp->fp = NULL;
+	srfmp->vp = vp;
+	srfmp->file_size = (memory_object_size_t)size;
+	srfmp->file_control = MEMORY_OBJECT_CONTROL_NULL;
+	kr = vm_shared_region_map_file(shared_region, 1, srfmp);
+	printf("bbk sr: premap map kr=0x%x size=%lld mappings=%u\n", kr, (long long)size,
+	    header.mappingCount);
+	error = (kr == KERN_SUCCESS) ? 0 : EIO;
+out:
+	if (srfmp != NULL) {
+		kfree_data(srfmp, sizeof(*srfmp));
+	}
+	if (mappings != NULL) {
+		kfree_data(mappings, header.mappingCount * sizeof(*mappings));
+	}
+	if (vp != NULL) {
+		vnode_put(vp);
+	}
+	return error;
+}
 #endif
 
 #if defined(XNU_OWNER_DATA_MOUNT) && XNU_OWNER_DATA_MOUNT
@@ -8232,6 +8424,8 @@ load_init_program(proc_t p)
 	printf("bbk init: cache_prepare err=%d envp=0x%llx\n", cache_error,
 	    (unsigned long long)init_envp);
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
+	native_owner_cache_premap_pending = 1;
+	printf("bbk sr: premap pending (exec will enter the shared region)\n");
 #endif
 #if defined(XNU_OWNER_DATA_MOUNT) && XNU_OWNER_DATA_MOUNT
