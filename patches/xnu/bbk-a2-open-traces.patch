+		char bbk_path[200];
+		if (copyinstr(uap->path, bbk_path, sizeof(bbk_path), NULL) != 0) {
+			strlcpy(bbk_path, "<bad ptr>", sizeof(bbk_path));
+		}
+		printf("bbk open: path=%s flags=0x%x -> err=%d\n", bbk_path, uap->flags, bbk_error);
+	}
+	return bbk_error;
 }
 
