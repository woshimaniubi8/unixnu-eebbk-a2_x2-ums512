+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int error = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+	if (error) return error;
+	error = vnode_size(vp, &size, ctx);
+	if (!error && size != sizeof(original)) error = EINVAL;
+	int resid = 0;
+	if (!error) error = vn_rdwr(UIO_READ, vp, (caddr_t)original, sizeof(original), 0,
+	    UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid, p);
+	int close_error = vnode_close(vp, FREAD, ctx); vp = NULLVP;
+	if (!error && (resid || close_error)) error = resid ? EIO : close_error;
+	if (error) return error;
+	SHA256_CTX hash;
+	SHA256_Init(&hash); SHA256_Update(&hash, original, sizeof(original)); SHA256_Final(digest, &hash);
+	if (memcmp(digest, original_sha, sizeof(digest))) return EINVAL;
+	error = native_gpu_addon_parents(p, scratch, staged);
+	if (error) return error;
+	error = native_gpu_addon_write(staged, configuration, sizeof(configuration), 0644, ctx);
+	/* -1 is this existing writer's explicit byte-identical result. */
+	if (error == -1) error = 0;
+	if (error) return error;
+	error = native_cryptex_os_bind(p, scratch, "/private/var/ngpu/splashboard-launchd",
+	    "/System/Library/LaunchDaemons", MNT_UNION);
+	if (error) return error;
+	error = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+	if (error) return error;
+	int visible = native_gpu_addon_equal(vp, configuration, sizeof(configuration), 0644, ctx);
