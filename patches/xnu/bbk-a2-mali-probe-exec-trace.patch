--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -3571,6 +3571,28 @@
 	return 0;
 }
 
+static bool
+bbk_mali_probe_exec_trace(proc_t p, user_addr_t path, const char *operation)
+{
+	static const char probe_path[] = "/private/var/ngpu/mali-user/mali-user-probe";
+	static uint32_t attempts;
+	const char *name = proc_best_name(p);
+	if (proc_getpid(p) != 1 && strcmp(name, "launchd") && strcmp(name, "xpcproxy")) {
+		return false;
+	}
+	char candidate[sizeof(probe_path)];
+	size_t copied = 0;
+	if (copyinstr(path, candidate, sizeof(candidate), &copied) || copied != sizeof(probe_path) ||
+	    memcmp(candidate, probe_path, sizeof(probe_path))) {
+		return false;
+	}
+	if (__atomic_fetch_add(&attempts, 1u, __ATOMIC_RELAXED) >= 8u) {
+		return false;
+	}
+	printf("M156 mali-user: %s enter pid=%d\n", operation, proc_getpid(p));
+	return true;
+}
+
 /*
  * posix_spawn
  *
@@ -3603,6 +3625,7 @@
 int
 posix_spawn(proc_t ap, struct posix_spawn_args *uap, int32_t *retval)
 {
+	const bool probe_trace = bbk_mali_probe_exec_trace(ap, uap->path, "spawn");
 	proc_t p = ap;
 	user_addr_t pid = uap->pid;
 	int ival[2];            /* dummy retval for setpgid() */
@@ -4961,6 +4984,9 @@
 	}
 #endif
 
+	if (probe_trace) {
+		printf("M156 mali-user: spawn result=%d\n", error);
+	}
 	assert(spawn_no_exec || exec_failure_reason == NULL);
 	return error;
 }
@@ -5223,6 +5249,7 @@
 int
 __mac_execve(proc_t p, struct __mac_execve_args *uap, int32_t *retval __unused)
 {
+	const bool probe_trace = bbk_mali_probe_exec_trace(p, uap->fname, "exec");
 	struct image_params *imgp = NULL;
 	struct vnode_attr *vap = NULL;
 	struct vnode_attr *origvap = NULL;
@@ -5532,9 +5559,12 @@
 	uthread_set_exec_data(current_uthread(), NULL);
 	kfree_type(typeof(*__execve_data), __execve_data);
 
 	if (inherit != NULL) {
 		ipc_importance_release(inherit);
 	}
 
+	if (probe_trace) {
+		printf("M156 mali-user: exec result=%d\n", error);
+	}
 	return error;
 }
