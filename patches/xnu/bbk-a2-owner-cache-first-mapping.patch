diff --git a/osfmk/vm/vm_shared_region.c b/osfmk/vm/vm_shared_region.c
index 1ab7232..bed797b 100644
--- a/osfmk/vm/vm_shared_region.c
+++ b/osfmk/vm/vm_shared_region.c
@@ -1674,6 +1674,17 @@ vm_shared_region_map_file_setup(
 				break;
 			}
 
+			/*
+			 * Record the first successful mapping in the shared region,
+			 * exactly like the regular file-backed path below.  Without
+			 * this the fd==-1 (anonymous) path leaves sr_first_mapping
+			 * at UINT64_MAX and map_file_final() reads the cache header
+			 * from sr_base_address - 1.
+			 */
+			if (shared_region->sr_first_mapping == (mach_vm_offset_t)-1) {
+				shared_region->sr_first_mapping = target_address;
+			}
+
 			if (mappings[0].sms_address < *sfm_min_address) {
 				*sfm_min_address = mappings[0].sms_address;
 			}
