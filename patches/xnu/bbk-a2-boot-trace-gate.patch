+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef BBK_BOOT_TRACE_H
+#define BBK_BOOT_TRACE_H
+#include <pexpert/pexpert.h>
+/* Boot arguments are immutable here. Parsing the opt-in avoids an unsynchronised
+ * lazily initialised global in paths entered concurrently during exec and VFS. */
+static inline int
+bbk_boot_trace_enabled(void)
+{
+    int enabled = 0;
+    return PE_parse_boot_argn("bbk-boot-trace", &enabled, sizeof(enabled)) && enabled != 0;
+}
+#define BBK_BOOT_TRACE(...) do { if (bbk_boot_trace_enabled()) { printf(__VA_ARGS__); } } while (0)
+#define BBK_BOOT_TRACE_ERROR(failed, ...) do { if ((failed) || bbk_boot_trace_enabled()) { printf(__VA_ARGS__); } } while (0)
+#endif
