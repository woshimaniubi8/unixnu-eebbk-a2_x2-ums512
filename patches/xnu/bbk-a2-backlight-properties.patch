+// Permit only CoreBrightness's bounded brightness/fade dictionary on the
+// physical PWM2 service. Preserve the original MACF decision for every other
+// service, process and property.
+extern "C" void proc_selfname(char *buf, int size);
+static bool
+native_sprd_backlight_set(IORegistryEntry *entry, OSObject *object)
+{
+    OSString *backend = OSDynamicCast(OSString, entry->getProperty("HardwareBackend"));
+    OSDictionary *dict = OSDynamicCast(OSDictionary, object);
+    if (!backend || !backend->isEqualTo("UMS512 PWM2, factory 1h190 curve") ||
+        !dict || dict->getCount() < 1 || dict->getCount() > 2) return false;
+    char name[17] = {};
+    proc_selfname(name, sizeof(name));
+    if (strcmp(name, "backboardd")) return false;
+    OSNumber *brightness = OSDynamicCast(OSNumber, dict->getObject("brightness"));
+    OSNumber *fade = OSDynamicCast(OSNumber, dict->getObject("FadePeriod"));
+    return brightness && brightness->unsigned64BitValue() <= 255 &&
+        (dict->getCount() == 1 || fade != nullptr);
+}
+
 /* Routine io_registry_entry_set_properties */
 kern_return_t
 is_io_registry_entry_set_properties
