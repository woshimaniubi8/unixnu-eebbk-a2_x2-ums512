# Device patch series (format 2).
#
# board.toml [kernel] patch_series replaces the OS profile's series with this
# one: the profile's first entry, zzz-boot-progress.patch, is generated against
# the SM8550/sheng XNU_SHENG_PMGR context and cannot apply to this Unisoc
# kernel.  The two XnuPrelink patches are SoC independent and are required by
# the prelink step, so they are carried here instead.
xnu-10063.141.1-security-init.patch
xnu-10063.141.1-sparse-index.patch

# SDHCI eMMC block transport: register the NativeSdhciBlock personality in
# gIOKernelConfigTables.  The device series is applied last, so this patch sits
# on top of the arch series' own personality patches (armvirt-platform and
# native-aes); it is compiled in when the defconfig passes
# -DXNU_NATIVE_SDHCI_BLOCK=1 through CONFIG_XNU_EXTRA_CFLAGS.
sdhci-block-personality.patch

# BBK A2 bring-up: skip the root hash authentication panic when the boot
# argument bbk-skip-rootauth=1 is set (board.toml [payload] kernel_args).  The
# patch keeps the original panic when the argument is absent, so the sealed-root
# behaviour is unchanged without it.
bbk-a2-skip-root-auth.patch

# TEMPORARY bring-up instrumentation for the offline owner cache path (milestone
# 9): prints the SystemOS mount, the dyld cache lookups, the shared-region
# carrier decision and the injected DYLD_SHARED_CACHE_DIR.  Remove this entry
# once the shared region works.
bbk-a2-owner-cache-debug.patch

# BBK A2 bring-up: preload the owner's main dyld shared cache into the task's
# shared region before launchd execs (like iBoot does), so dyld's
# shared_region_check_np() reports a mapped region and dyld maps the subcaches
# through shared_region_map_and_slide_2_np().  Maps the cache file's own header
# mapping table with slide 0 and fails soft.
bbk-a2-owner-cache-premap.patch
# BBK A2 bring-up: record sr_first_mapping in the fd == -1 (anonymous) branch of
# vm_shared_region_map_file_setup(), like the file-backed path does, so the
# premapped owner cache's header can be read back by map_file_final().
bbk-a2-owner-cache-first-mapping.patch
# BBK A2 bring-up: pid 1 crash-site traces (user abort ESR/FAR/PC and postsig
# signal) for the offline dyld shared cache bring-up.
bbk-a2-crash-traces.patch
# BBK A2 bring-up: print the paths pid 1 opens (flags + errno), to see which
# dyld shared cache path launchd actually probes.
bbk-a2-open-traces.patch
# BBK A2 bring-up: print pid 1's mmap/pread/read/fstat/close calls with their
# arguments and errno, so the step after the cache files are opened (mapping,
# header validation or give-up) becomes visible on the UART.
bbk-a2-syscall-traces.patch
