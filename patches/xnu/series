# Device patch series (format 2).
#
# board.toml [kernel] patch_series replaces the OS profile's series with this
# one: the profile's first entry, zzz-boot-progress.patch, is generated against
# the SM8550/sheng XNU_SHENG_PMGR context and cannot apply to this Unisoc
# kernel.  The two XnuPrelink patches are SoC independent and are required by
# the prelink step, so they are carried here instead.
xnu-10063.141.1-security-init.patch
xnu-10063.141.1-sparse-index.patch

# SDHCI eMMC block transport: register the NativeSdhciBlock personality in
# gIOKernelConfigTables.  The device series is applied last, so this patch sits
# on top of the arch series' own personality patches (armvirt-platform and
# native-aes); it is compiled in when the defconfig passes
# -DXNU_NATIVE_SDHCI_BLOCK=1 through CONFIG_XNU_EXTRA_CFLAGS.
sdhci-block-personality.patch

# BBK A2 bring-up: skip the root hash authentication panic when the boot
# argument bbk-skip-rootauth=1 is set (board.toml [payload] kernel_args).  The
# patch keeps the original panic when the argument is absent, so the sealed-root
# behaviour is unchanged without it.
bbk-a2-skip-root-auth.patch

# TEMPORARY bring-up instrumentation for the offline owner cache path (milestone
# 9): prints the SystemOS mount, the dyld cache lookups, the shared-region
# carrier decision and the injected DYLD_SHARED_CACHE_DIR.  Remove this entry
# once the shared region works.
bbk-a2-owner-cache-debug.patch

# BBK A2 bring-up: preload the owner's main dyld shared cache into the task's
# shared region before launchd execs (like iBoot does), so dyld's
# shared_region_check_np() reports a mapped region and dyld maps the subcaches
# through shared_region_map_and_slide_2_np().  Maps the cache file's own header
# mapping table with slide 0 and fails soft.
bbk-a2-owner-cache-premap.patch
# BBK A2 bring-up: record sr_first_mapping in the fd == -1 (anonymous) branch of
# vm_shared_region_map_file_setup(), like the file-backed path does, so the
# premapped owner cache's header can be read back by map_file_final().
bbk-a2-owner-cache-first-mapping.patch
# BBK A2 bring-up: pid 1 crash-site traces (user abort ESR/FAR/PC and postsig
# signal) for the offline dyld shared cache bring-up.
bbk-a2-crash-traces.patch
# BBK A2 bring-up: print the paths pid 1 opens (flags + errno), to see which
# dyld shared cache path launchd actually probes.
bbk-a2-open-traces.patch
# BBK A2 bring-up: print pid 1's mmap/pread/read/fstat/close calls with their
# arguments and errno, so the step after the cache files are opened (mapping,
# header validation or give-up) becomes visible on the UART.
bbk-a2-syscall-traces.patch
# BBK A2 bring-up: add the return values to those traces (open fd, pread/read
# byte counts, mmap address) and the fstat size, so a short read or a failed
# mapping is distinguishable from a successful one.
bbk-a2-trace-returns.patch
# BBK A2 bring-up: pair the syscall traces with entry records and cover
# fcntl(92/406), fstat64(339), close_nocancel(399) and munmap(73), decoding
# F_ADDFILESIGS_RETURN so the dyld cache preflight of fd 4 becomes visible.
bbk-a2-syscall-entry.patch
# BBK A2 bring-up: stage traces inside the F_ADDFILESIGS_RETURN path
# (ubc_cs_blob_get/allocate, vn_rdwr, ubc_cs_blob_add, cs_blob_init_validated,
# reconstitute_code_signature, mac_vnode_check_signature) so the fd 4 stall can
# be attributed to a specific stage.
bbk-a2-cs-traces.patch
# BBK A2 bring-up: trace the VFS boundary of pid 1's >=1 MiB reads (vn_rdwr
# entry, MAC read check, VNOP_READ entry/exit) so the native4k precheck stall
# can be placed before or after the filesystem/block layer.
bbk-a2-vfs-read-traces.patch
# BBK A2 bring-up: the "[System Event]" console lines are emitted
# unconditionally and swamp the 115200 baud UART while the dyld path is traced.
# Gate them behind the bbk-sysevent boot argument (silent by default).
bbk-a2-quiet-system-events.patch
# BBK A2 bring-up: there is no CHRP NVRAM controller on this board, so the
# flash sync always failed with kIOReturnNotReady; AMFI then retried its
# security-mode-change-enable write and leaked OSDictionary/kalloc objects
# until the VM asserted.  Treat the no-controller sync as a success (the
# variable dictionary is already updated in memory) and count the calls.
bbk-a2-nvram-no-controller.patch
# BBK A2 bring-up: AMFI's IODTNVRAM setter helper is entered millions of times
# and never releases the matching dictionary it builds with
# serviceMatching("IODTNVRAM"), which leaked one OSDictionary per call until the
# VM asserted.  Release that reference for the measured call site only
# (caller == 0xfffffff004aaed30) and keep a sparse record of the calling thread
# and its caller; every other caller keeps the documented ownership rules.
bbk-a2-amfi-matching-leak.patch
# BBK A2 bring-up: record the object type and IOReturn of AMFI's
# security-mode-change-enable property write, plus the read-back value, so a
# caller that loops on the value can be told apart from one that retries
# unconditionally.
bbk-a2-nvram-setproperty-trace.patch
# BBK A2 bring-up: print the RamBlock-selected Data volume device and the cryptex union stage/status.
bbk-a2-data-mount-trace.patch
# BBK A2 bring-up: mockfs' 0x6D6F636B type number made vfs_init() set
# maxvfstypenum to ~1.8e9, so libc's getvfsbyname("tmpfs") scanned the whole
# range before mount_tmpfs could report a missing tmpfs.  Give mockfs the next
# small type and start dynamic allocations after it.
bbk-a2-vfs-small-typenums.patch
# BBK A2 bring-up: the tmpfs kext is in the prelink image but has no IOKit
# personality, so it is not started automatically.  Load it through the normal
# OSKext API after vfsinit(), then read back vfsconf and print load/registration
# so mount_tmpfs' getvfsbyname("tmpfs") can succeed.
bbk-a2-tmpfs-load-probe.patch
