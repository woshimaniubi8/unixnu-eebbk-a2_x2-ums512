+	 * root-only files through the existing read-only bindfs union support. */
+	error = native_cryptex_os_bind(p, scratch,
+	    "/private/preboot/usr/lib", "/usr/lib", MNT_UNION);
 	if (!error) {
-		vnode_put(probe);
 		native_cryptex_os_stage = 5;
 	}
 	native_cryptex_os_status = error;
