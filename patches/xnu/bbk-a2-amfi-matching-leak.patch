diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index c22edff..86ef13f 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -6613,7 +6613,31 @@ IOService *
 IOService::waitForMatchingService( OSDictionary * matching,
     uint64_t timeout)
 {
-	return IOService::waitForMatchingServiceWithToken(matching, timeout, NULL);
+	IOService *result = IOService::waitForMatchingServiceWithToken(matching, timeout, NULL);
+
+	//
+	// BBK A2 bring-up: AMFI's IODTNVRAM setter helper is entered millions of
+	// times (99.log: 32.5M calls) and never releases the matching dictionary it
+	// builds with serviceMatching("IODTNVRAM"), which leaked one OSDictionary
+	// per call.  Release that reference for the measured call site only, and
+	// keep a sparse record of the calling thread and its caller so the retry
+	// source can be identified without flooding the UART.
+	//
+	uintptr_t caller = (uintptr_t)__builtin_return_address(0);
+	if ((matching != nullptr) && (caller == 0xfffffff004aaed30ULL)) {
+		static uint32_t calls = 0;
+		uint32_t count = __atomic_add_fetch(&calls, 1, __ATOMIC_RELAXED);
+		if ((count <= 8) || ((count & 0xfffff) == 0)) {
+			printf("bbk amfi: wait caller=0x%lx outer=0x%lx matching=%p result=%p timeout=0x%llx tid=%lld calls=%u\n",
+			    (unsigned long)caller,
+			    (unsigned long)(uintptr_t)__builtin_return_address(1),
+			    matching, result, (unsigned long long)timeout,
+			    (long long)thread_tid(current_thread()), count);
+		}
+		matching->release();
+	}
+
+	return result;
 }
 
 IOService *
