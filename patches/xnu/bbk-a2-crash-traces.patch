diff --git a/bsd/kern/kern_sig.c b/bsd/kern/kern_sig.c
index 6f93e15..156ee70 100644
--- a/bsd/kern/kern_sig.c
+++ b/bsd/kern/kern_sig.c
@@ -3133,6 +3133,9 @@ postsig_locked(int signum)
 		KERNEL_DEBUG_CONSTANT(BSDDBG_CODE(DBG_BSD_PROC, BSD_PROC_FRCEXIT) | DBG_FUNC_NONE,
 		    proc_getpid(p), W_EXITCODE(0, signum), 3, 0, 0);
 
+		if (proc_getpid(p) == 1) {
+			printf("bbk sig: pid=1 sig=%d\n", signum);
+		}
 		exit_with_reason(p, W_EXITCODE(0, signum), (int *)NULL, TRUE, TRUE, 0, ut_exit_reason);
 
 		proc_lock(p);
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index ff5296d..a9dfcf5 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1236,6 +1236,13 @@ handle_breakpoint(arm_saved_state_t *state, uint32_t esr __unused)
 	}
 #endif /* __has_feature(ptrauth_calls) */
 
+	if (task_pid(current_task()) == 1) {
+		printf("bbk exc: pid=1 esr=0x%08x far=0x%016llx pc=0x%016llx lr=0x%016llx sp=0x%016llx prot=0x%x\n",
+		    esr, (unsigned long long)fault_addr,
+		    (unsigned long long)get_saved_state_pc(state),
+		    (unsigned long long)get_saved_state_lr(state),
+		    (unsigned long long)get_saved_state_sp(state), fault_type);
+	}
 	codes[1] = get_saved_state_pc(state);
 	exception_triage(exception, codes, numcodes);
 	__builtin_unreachable();
