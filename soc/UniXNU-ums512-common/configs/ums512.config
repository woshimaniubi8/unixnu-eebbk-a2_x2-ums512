# Unisoc UMS512 / SharkL5Pro shared kernel configuration.
#
# Mirrors the reference first-boot tree hxzbaka/UniXNU-t610yp (t610yp_defconfig):
# the BCM2837 machine configuration + ARMVIRT platform is what the non-Apple
# machine layer (ums512-open-machine-layer.patch) builds against, and the SPRD
# polled UART console comes from ums512-uart.patch.
CONFIG_XNU_MACHINE_CONFIG="BCM2837"
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_ARMVIRT_PLATFORM=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_BUILD_ARCHIVES=y

# No Apple storage/display/GPU paths in the bring-up defconfig.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_TRUST_CACHE=0