# Unisoc UMS512 / SharkL5Pro shared kernel configuration.
#
# Values are taken from the vendor device tree (boot.bin appended DTB,
# analysis/extracted/boot/boot-dtb.dtb) and from the T610YP bring-up tree
# (hxzbaka/UniXNU-t610yp) which targets the same SoC family.
#
# The first milestone only needs the device-tree platform, ARM CPU, GIC and the
# architectural timer; storage, display and GPU are intentionally left out until
# the UART/framebuffer/XNU entry path is stable on real hardware.

CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

# No storage / display / GPU in the bring-up defconfig.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n

# Trust cache is disabled until the UEFI payload FAT volume and the iOS restore
# inputs are wired up; the T610YP tree makes the same choice for first entry.
CONFIG_XNU_NATIVE_TRUST_CACHE=0
